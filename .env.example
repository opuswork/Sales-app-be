# Copy to .env and fill in values. Never commit real secrets.

# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgresql://postgres:sales_app@localhost:5436/sales_app?schema=public
# Render Postgres: external URL + ?sslmode=require

PORT=3002
NODE_ENV=development

# JWT — access token (short) + refresh token (long, "로그인 유지")
JWT_SECRET=change-me-sales-app-dev-secret
JWT_ACCESS_SECONDS=3600
JWT_REFRESH_DAYS=90

# CORS — Vercel FE origin, no trailing slash
FRONTEND_ORIGIN=http://localhost:3000

# 시스템 관리자 계정 (첫 기동 시 자동 생성, 담당자 목록에 안 보임). 로그인 ID 또는 이메일
SEED_ADMIN_EMAIL=sysadmin
SEED_ADMIN_PASSWORD=change-me-1234

# 녹취 파일 저장: Render 는 디스크가 휘발되므로 Vercel Blob 사용. 비우면 로컬 ./uploads 에 저장
BLOB_READ_WRITE_TOKEN=

# 녹취 분석 (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# STT 워커(이 PC의 GPU)가 서버에서 작업을 가져갈 때 쓰는 토큰
WORKER_TOKEN=change-me-worker-token

# 카카오 i 오픈빌더 스킬 서버: 요청 검증용 비밀 (오픈빌더 스킬 URL 의 ?key= 값과 동일하게)
KAKAO_SKILL_KEY=change-me-kakao-key
